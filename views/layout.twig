<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title|default(app_name) }}</title>
    <link rel="stylesheet" href="./assets/style.css">
</head>
<body>
<header class="site-header">
    <nav class="nav">
        <a class="brand" href="{{ url('home') }}">⚔ {{ app_name }}</a>
        {% if current_user %}
            <a href="{{ url('characters_my') }}">Мои персонажи</a>
            <a href="{{ url('characters_find') }}">Поиск</a>
            <a href="{{ url('characters_create') }}">+ Персонаж</a>
            <span class="spacer"></span>
            <span class="user-badge">{{ current_user.username }}</span>
            <a href="{{ url('logout') }}">Выход</a>
        {% else %}
            <span class="spacer"></span>
            <a href="{{ url('login') }}">Вход</a>
            <a href="{{ url('register') }}">Регистрация</a>
        {% endif %}
    </nav>
</header>

<main class="container">
    {% for flash in flashes %}
        <div class="flash flash-{{ flash.type }}">{{ flash.message }}</div>
    {% endfor %}

    {% block content %}{% endblock %}
</main>

<footer class="site-footer">
    <p>
        {{ app_name }} · учебный проект на PHP с Twig · {{ "now"|date("Y") }}
        <h6><i>"ООО Команда номер 4"</i></h6>
    </p>
</footer>

<script src="assets/app.js"></script>
</body>
</html>
