{# Общая форма персонажа: создание, редактирование, админка. #}
<form id="character-form"
      method="post"
      action="{{ action }}"
      data-alignments="{{ alignments|join('|') }}">

    {{ csrf_field() }}

    <div class="form-row">
        <label for="name">Имя персонажа *</label>
        <input id="name" type="text" name="name" value="{{ data.name }}"
               class="{{ error_class(errors, 'name') }}">
        {{ field_error(errors, 'name') }}
    </div>

    <div class="form-grid">
        <div class="form-row">
            <label for="race_id">Раса *</label>
            <select id="race_id" name="race_id" class="{{ error_class(errors, 'race_id') }}">
                <option value="">— выберите расу —</option>
                {% for race in races %}
                    <option value="{{ race.id }}"{{ selected_option(data.race_id, race.id) }}>{{ race.name }}</option>
                {% endfor %}
            </select>
            {{ field_error(errors, 'race_id') }}
        </div>

        <div class="form-row">
            <label for="class_id">Класс *</label>
            <select id="class_id" name="class_id" class="{{ error_class(errors, 'class_id') }}">
                <option value="">— выберите класс —</option>
                {% for class in classes %}
                    <option value="{{ class.id }}"{{ selected_option(data.class_id, class.id) }}>{{ class.name }}</option>
                {% endfor %}
            </select>
            {{ field_error(errors, 'class_id') }}
        </div>

        <div class="form-row">
            <label for="level">Уровень (1–20) *</label>
            <input id="level" type="number" name="level" min="1" max="20"
                   value="{{ data.level }}" class="{{ error_class(errors, 'level') }}">
            {{ field_error(errors, 'level') }}
        </div>

        <div class="form-row">
            <label for="alignment">Мировоззрение *</label>
            <select id="alignment" name="alignment" class="{{ error_class(errors, 'alignment') }}">
                <option value="">— выберите мировоззрение —</option>
                {% for alignment in alignments %}
                    <option value="{{ alignment }}"{{ selected_option(data.alignment, alignment) }}>{{ alignment }}</option>
                {% endfor %}
            </select>
            {{ field_error(errors, 'alignment') }}
        </div>
    </div>

    <fieldset class="stats-fieldset">
        <legend>Характеристики (3–18) *</legend>
        <div class="form-grid">
            {% for stat in stats %}
                <div class="form-row">
                    <label for="{{ stat }}">{{ stat_labels[stat] }}</label>
                    <input id="{{ stat }}" type="number" name="{{ stat }}" min="3" max="18"
                           value="{{ data[stat] }}" class="{{ error_class(errors, stat) }}">
                    {{ field_error(errors, stat) }}
                </div>
            {% endfor %}
        </div>
    </fieldset>

    <div class="form-row">
        <label for="backstory">Предыстория (до 2000 символов)</label>
        <textarea id="backstory" name="backstory" rows="4"
                  class="{{ error_class(errors, 'backstory') }}">{{ data.backstory }}</textarea>
        {{ field_error(errors, 'backstory') }}
    </div>

    <button type="submit" class="btn">Сохранить персонажа</button>
</form>
