{% extends 'layout.twig' %}

{% block content %}
<section class="panel">
    <div class="panel-head">
        <h1>Мои персонажи</h1>
        <a class="btn" id="add" href="{{ url('characters_create') }}">+ Создать персонажа</a>
    </div>

    {% if characters is empty %}
        <p class="muted">У вас пока нет персонажей. <a href="{{ url('characters_create') }}">Создайте первого героя</a>!</p>
    {% else %}
        <table>
            <thead>
            <tr>
                <th>Имя</th><th>Раса</th><th>Класс</th><th>Уровень</th>
                <th class="hide-mobile">Мировоззрение</th>
                <th class="hide-mobile">Создан</th><th></th>
            </tr>
            </thead>
            <tbody>
            {% for character in characters %}
                <tr>
                    <td><a href="{{ url('character_view', {id: character.id}) }}">{{ character.name }}</a></td>
                    <td>{{ character.race_name }}</td>
                    <td>{{ character.class_name }}</td>
                    <td>{{ character.level }}</td>
                    <td class="hide-mobile">{{ character.alignment }}</td>
                    <td class="hide-mobile">{{ format_date(character.created_at) }}</td>
                    <td class="actions">
                        <a class="view-character" href="{{ url('character_view', {id: character.id}) }}"
                           title="Посмотреть" aria-label="Посмотреть">Посмотреть</a>
                        <a href="{{ url('character_edit', {id: character.id}) }}">Изменить</a>
                        <form class="inline" method="post" action="{{ url('character_delete') }}"
                              onsubmit="return confirm('Удалить персонажа «{{ character.name|e('js') }}»? Это действие необратимо.');">
                            {{ csrf_field() }}
                            <input type="hidden" name="id" value="{{ character.id }}">
                            <button type="submit" class="link-danger">Удалить</button>
                        </form>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% endif %}
</section>
{% endblock %}
