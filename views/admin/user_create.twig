{% extends 'layout.twig' %}

{% block content %}
<section class="panel form-panel">
    <h1>Новый пользователь</h1>

    <form method="post" action="{{ url('admin_user_create') }}">
        {{ csrf_field() }}

        <div class="form-row">
            <label for="username">Имя пользователя *</label>
            <input id="username" type="text" name="username" value="{{ data.username }}"
                   class="{{ error_class(errors, 'username') }}" autofocus>
            {{ field_error(errors, 'username') }}
            <p class="hint">3–30 символов: латиница, цифры, подчёркивание.</p>
        </div>

        <div class="form-row">
            <label for="email">Email *</label>
            <input id="email" type="text" name="email" value="{{ data.email }}"
                   class="{{ error_class(errors, 'email') }}">
            {{ field_error(errors, 'email') }}
        </div>

        <div class="form-row">
            <label for="password">Пароль *</label>
            <input id="password" type="password" name="password" class="{{ error_class(errors, 'password') }}">
            {{ field_error(errors, 'password') }}
            <p class="hint">Минимум 6 символов.</p>
        </div>

        <div class="form-row">
            <label for="password_confirm">Повторите пароль *</label>
            <input id="password_confirm" type="password" name="password_confirm"
                   class="{{ error_class(errors, 'password_confirm') }}">
            {{ field_error(errors, 'password_confirm') }}
        </div>

        <div class="form-row">
            <label class="checkbox-row">
                <input type="checkbox" name="is_admin" value="1" {% if data.is_admin %}checked{% endif %}>
                Права администратора
            </label>
        </div>

        <button type="submit" class="btn">Создать пользователя</button>
        <a class="btn btn-secondary" href="{{ url('admin_users') }}">Отмена</a>
    </form>
</section>
{% endblock %}
