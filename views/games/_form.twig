{# Тут форма для создания игры/ваншота #}

<div id="game_form">
    <form method="POST" action="">
        <div>
            <label for="game_title">Название игры / ваншота:</label><br>
            <input type="text" id="game_title" name="game_title" placeholder="Например: Поход в подземелье" required>
        </div>

        <br>

        <div>
            <label for="game_format">Формат:</label><br>
            <select id="game_format" name="game_format">
                <option value="oneshot">Ваншот (1 сессия)</option>
                <option value="campaign">Кампейн</option>
            </select>
        </div>

        <br>

        <div>
            <label for="start_level">Стартовый уровень:</label><br>
            <input type="number" id="start_level" name="start_level" min="1" max="20" value="3">
        </div>

        <br>

        <div>
            <label for="description">Описание и завязка:</label><br>
            <textarea id="description" name="description" rows="4" placeholder="Краткое описание приключения..."></textarea>
        </div>

        <br>

        <button type="submit">Создать игру</button>
    </form>
</div>
